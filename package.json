{
	"name": "svelte-dev-monorepo",
	"version": "0.0.1",
	"description": "monorepo for svelte.dev",
	"private": true,
	"type": "module",
	"license": "MIT",
	"packageManager": "pnpm@9.2.0",
	"engines": {
		"pnpm": ">=9.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sveltejs/svelte.dev.git"
	},
	"scripts": {
		"check": "pnpm --filter @sveltejs/repl check",
		"lint": "pnpm --filter @sveltejs/repl lint",
		"format": "pnpm --filter @sveltejs/repl format",
		"test": "pnpm --filter @sveltejs/repl test",
		"build": "pnpm --filter @sveltejs/repl build",
		"dev": "pnpm --filter @sveltejs/repl dev",
		"changeset:version": "changeset version && pnpm -r generate:version && git add --all",
		"changeset:publish": "changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^2.27.10"
	}
}
